# --- Redis (queue + deployment state + build logs) ---
REDIS_URL=redis://localhost:6380

# --- MinIO / S3 (source tarballs + build artifacts) ---
S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=deployments
S3_REGION=us-east-1

# --- Services ---
UPLOAD_PORT=3002
PROXY_PORT=3000

# Base host for generated URLs. Locally *.localhost resolves to 127.0.0.1
# with no /etc/hosts edits. On a real VM this becomes your wildcard domain.
ROOT_DOMAIN=localhost
