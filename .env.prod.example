# Wildcard DNS must point *.<ROOT_DOMAIN> at this machine.
ROOT_DOMAIN=localhost
PUBLIC_SCHEME=http
# Port users reach. Set to 80 (with PROXY_PUBLISH_PORT=80) behind a real domain.
PUBLIC_PORT=3000

PROXY_PUBLISH_PORT=3000
UPLOAD_PUBLISH_PORT=3002

# CHANGE THESE before exposing the VM.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=deployments

# --- TLS (only needed for the `tls` profile) ---
# Let's Encrypt contact address for expiry notices.
ACME_EMAIL=you@example.com
