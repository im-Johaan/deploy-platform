{
	email {$ACME_EMAIL}

	# Ask the upload service before issuing a certificate for a hostname.
	# This is what stops strangers from burning the Let's Encrypt rate limit
	# by requesting subdomains that were never deployed.
	on_demand_tls {
		ask http://upload:3002/tls-check
	}
}

# The platform itself: UI + API. Password-protected — without this, anyone
# who finds the domain can run builds on your machine and publish pages
# under your name.
{$ROOT_DOMAIN} {
	basic_auth {
		{$ADMIN_USER} {$ADMIN_PASSWORD_HASH}
	}
	reverse_proxy upload:3002 {
		# So the upload service can record who created each deployment.
		header_up X-Forwarded-For {remote_host}
	}
}

# Every deployment. Public by design — these are the sites you publish.
# Certificates are issued per hostname on first request, so no wildcard
# certificate and no DNS provider plugin is needed.
*.{$ROOT_DOMAIN} {
	tls {
		on_demand
	}
	reverse_proxy proxy:3000
}
